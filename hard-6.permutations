public class PermutationsOfNumber {
    public static void main(String[] args) {
        String number = "123"; 
        int n = number.length();
        char[] arr = number.toCharArray();

        int[] factorial = new int[n + 1];
        factorial[0] = 1;
        for (int i = 1; i <= n; i++) {
            factorial[i] = factorial[i - 1] * i;
        }

        for (int i = 0; i < factorial[n]; i++) {
            char[] tempArr = arr.clone();
            int code = i;
            for (int div = n; div >= 1; div--) {
                int index = code % div;
                code /= div;
                System.out.print(tempArr[index]);
                System.arraycopy(tempArr, index + 1, tempArr, index, div - index - 1);
            }
            System.out.println();
        }
    }
}
