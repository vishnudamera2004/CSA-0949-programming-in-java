import java.util.Arrays;
import java.util.Scanner;

public class NthLargestNumber {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the size of the array: ");
        int size = scanner.nextInt();

        int[] numbers = new int[size];
        System.out.println("Enter the elements of the array:");
        for (int i = 0; i < size; i++) {
            numbers[i] = scanner.nextInt();
        }

        System.out.print("Enter the value of n (to find the nth largest number): ");
        int n = scanner.nextInt()
        Arrays.sort(numbers); // Sort the array in ascending order
        if (n <= 0 || n > size) {
            System.out.println("Invalid value for n. Please enter a value between 1 and " + size + ".");
        } else {
            int nthLargest = numbers[size - n];
            System.out.println("The " + n + "th largest number is: " + nthLargest);
        }

        scanner.close();
    }
}
